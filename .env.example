# Copy this file to ".env" and edit. The .env file is git-ignored, so your password is never uploaded.

# "mysql" (default) or "sqlite" (no server needed - easiest way to try the project)
DB_BACKEND=mysql

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password_here
DB_NAME=cs_project

# only if your MySQL server asks for it (older logins):
# DB_AUTH_PLUGIN=mysql_native_password
